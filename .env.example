# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="your-gemini-api-key"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---- GEHC API Server (npm run server) ----
PORT=8787
CORS_ORIGIN=http://localhost:8787,http://localhost:3000

# Google Drive — Service Account (mode rekomendasi, role-gated):
# 1. Buat service account + JSON key (panduan lengkap: drive-integration.md)
# 2. Share folder ROOT Drive GEHC ke client_email service account sebagai Viewer
# 3. Isi salah satu:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"..."}
# GOOGLE_APPLICATION_CREDENTIALS=./gehc-drive-service-account.json
# GDRIVE_IMPERSONATE=multimedia.gehc@gmail.com   (opsional, domain-wide delegation)
#
# Mode alternatif: API Key — hanya bisa folder PUBLIK di Drive
# GDRIVE_API_KEY=AIza...
#
# Folder root (ID BARE dari URL Drive, bukan URL lengkap!)
# Struktur folder & tag zona: lihat drive-integration.md
GDRIVE_ROOT_FOLDER_ID=1AbCdEfGhIjKlMnOp

# ---- Environment files (JANGAN commit kredensial asli!) ----
# .env              -> lokal dev (arah ke DB staging)
# .env.staging      -> dipakai script db:*:staging
# .env.production   -> dipakai script db:*:prod (JANGAN pernah isi di sini)

# ---- TiDB Cloud (Prisma) ----
# Local + Vercel Preview  → DATABASE_URL_STAGING
# GitHub main → Vercel Production → DATABASE_URL_PRODUCTION
# VERCEL_ENV=production di-detect otomatis; lokal default staging.
GEHC_ENV=staging
# Format: mysql://USER:PASSWORD@HOST:4000/DBNAME?sslaccept=strict
DATABASE_URL_STAGING="mysql://USER:PASSWORD@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/gehc?sslaccept=strict"
DATABASE_URL_PRODUCTION="mysql://USER:PASSWORD@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/gehc?sslaccept=strict"
DATABASE_URL="mysql://USER:PASSWORD@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/gehc?sslaccept=strict"


# ---- Google SSO (Google Identity Services) ----
# OAuth 2.0 Client ID dari Google Cloud Console (Credentials -> OAuth client ID -> Web application)
# Authorized JavaScript origins: http://localhost:3000 (+ domain produksi nanti)
GOOGLE_CLIENT_ID=
# Wajib untuk alur redirect /api/auth/google/start (invite lama). Daftar/join publik memakai GIS + CLIENT_ID saja.
# GOOGLE_CLIENT_SECRET=
# Maps / Places (alamat seperti e-commerce). Boleh sama project dengan SSO; enable Places + Maps JS API.
# GOOGLE_MAPS_API_KEY=
# Kunci HMAC cookie sesi (wajib di produksi; generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=
# Email yang otomatis dapat role SUPERADMIN saat pertama login
SUPERADMIN_EMAILS=

# ---- Demo personas (STAGING ONLY) ----
# true = persona switcher memakai akun dummy dari TiDB + bisa impersonate.
# JANGAN PERNAH set true di produksi!
ENABLE_DEMO_PERSONAS=false

# ---- BAKU TAU 4.0 ----
# Grup WhatsApp peserta (wajib https://chat.whatsapp.com/... atau https://wa.me/...)
BAKU_TAU_WA_GROUP_URL=

# ---- Registrasi mandiri via Google (halaman join publik) ----
# false = tombol daftar disembunyikan (cth. pasca-event). Default true.
REGISTRATION_OPEN=true