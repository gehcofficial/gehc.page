{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "env:sync": "node scripts/sync-env-from-staging.mjs",
    "env:check": "node scripts/check-env-parity.mjs",
    "dev": "node server/index.mjs",
    "dev:frontend": "vite --port=3000 --host=0.0.0.0",
    "dev:all": "node dev-all.mjs",
    "deploy:staging": "node scripts/deploy-staging.mjs",
    "server": "node server/index.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:local": "node scripts/db-migrate-local.mjs",
    "db:migrate:local:staging": "dotenv -e .env.staging -- node scripts/db-migrate-local.mjs",
    "db:migrate:local:prod": "dotenv -e .env.production -- node scripts/db-migrate-local.mjs",
    "db:schema:check": "node scripts/check-db-schema.mjs",
    "db:migrate:profile": "node server/_migrate-profile-phase1.cjs",
    "db:migrate:church-request": "node server/_migrate-profile-church-request.cjs",
    "db:migrate:placement": "node server/_migrate-jethro-placement.cjs",
    "db:migrate:birth-date": "node server/_migrate-birth-date.cjs",
    "db:migrate:org-hierarchy": "node server/_migrate-org-hierarchy.cjs",
    "db:migrate:e10-bakutau": "node server/_migrate-e10-bakutau.cjs",
    "db:backfill:org-assignments": "node server/backfill-org-assignments.cjs",
    "db:bridge:waitlist": "node server/_bridge-waitlist-to-pool.cjs",
    "db:seed": "tsx server/seed.ts",
    "db:seed:onboarding": "tsx server/seed-onboarding.ts",
    "db:push:staging": "dotenv -e .env.staging -- prisma db push",
    "db:migrate:staging": "dotenv -e .env.staging -- prisma migrate deploy",
    "db:seed:staging": "dotenv -e .env.staging -- tsx server/seed.ts",
    "db:seed:onboarding:staging": "dotenv -e .env.staging -- tsx server/seed-onboarding.ts",
    "db:seed:attendance:staging": "dotenv -e .env.staging -- tsx server/seed-attendance.ts",
    "db:seed-users:staging": "dotenv -e .env.staging -- tsx server/seed-users.ts",
    "db:seed:org-tree:staging": "dotenv -e .env.staging -- tsx server/seed-org-tree.ts",
    "db:seed:org-tree": "tsx server/seed-org-tree.ts",
    "db:migrate:prod": "dotenv -e .env.production -- prisma migrate deploy",
    "drive:provision": "node server/drive-provision.mjs",
    "drive:provision:prod": "dotenv -e .env.production -- node server/drive-provision.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test tests/e2e",
    "ci": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.34",
    "@ai-sdk/openai": "^4.0.51",
    "@google/genai": "^2.4.0",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.90.2",
    "@vitejs/plugin-react": "^5.0.4",
    "ai": "^7.0.84",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "googleapis": "^176.0.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mysql2": "^3.23.4",
    "pngjs": "^7.0.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.9.1",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.25.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^3.2.4"
  }
}
