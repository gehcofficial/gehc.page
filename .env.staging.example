# Template .env.staging — salin ke .env.staging dan isi secret asli.
# Dipakai: npm run db:*:staging, npm run dev:staging, mirror Vercel Preview.
# JANGAN commit .env.staging (sudah di-gitignore).

# ---- URL staging (Vercel) ----
APP_URL=https://staging-gehcpage.vercel.app
CORS_ORIGIN=https://staging-gehcpage.vercel.app

# ---- TiDB Cloud — branch youthgehc_staging ----
# Format user TiDB Cloud Serverless WAJIB pakai prefix: mysql://<prefix>.<user>:<password>@HOST:4000/DBNAME?sslaccept=strict
# Lihat: https://docs.pingcap.com/tidbcloud/select-cluster-tier#user-name-prefix
DATABASE_URL="mysql://USER:PASSWORD@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/gehc_staging?sslaccept=strict"

# ---- Google SSO ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
SUPERADMIN_EMAILS=

# ---- Demo personas (WAJIB true di staging, JANGAN di produksi) ----
ENABLE_DEMO_PERSONAS=true

# ---- Google Drive (root STAGING — lihat drive-integration.md §9) ----
GDRIVE_ROOT_FOLDER_ID=
# GOOGLE_APPLICATION_CREDENTIALS=./gehc-drive-service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ---- AI (opsional) ----
GEMINI_API_KEY=

# ---- Registrasi publik ----
REGISTRATION_OPEN=true

# ---- Frontend ----
VITE_API_BASE_URL=/api
