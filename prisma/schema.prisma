// GEHC Youth Ecosystem — Prisma schema untuk TiDB Cloud (MySQL-compatible)
// Referensi: https://www.prisma.io/docs/orm/prisma-schema

generator client {
  provider      = "prisma-client-js"
  // native = lokal dev; rhel-openssl-3.0.x = runtime Amazon Linux (Vercel serverless)
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id          String   @id @db.VarChar(64)
  name        String   @db.VarChar(150)
  slug        String   @unique @db.VarChar(80)
  domain      String?  @db.VarChar(150)
  description String?  @db.Text
  isActive    Boolean  @default(false) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)

  users  UserRole[]
  groups Group[]

  @@map("tenants")
}

enum Bipra {
  BAPAK
  IBU
  PEMUDA
  REMAJA
  ANAK
}

enum MembershipKind {
  JEMAAT
  SIMPATISAN
}

/// Kolom teritorial (satu jemaat satu Kolom). Campur BIPRA. Jumlah bisa berubah (simulasi: 5).
model Kolom {
  id     String  @id @db.VarChar(64)
  number Int     @unique
  name   String  @db.VarChar(120)
  area   String? @db.VarChar(190)

  users User[]

  @@map("kolom")
}

/// Minat rekreasional — hierarki: Sports/Arts → subkategori → minat (leaf, bisa banyak per orang).
model RecreationalGroup {
  id         String  @id @db.VarChar(64)
  slug       String  @unique @db.VarChar(40)
  name       String  @db.VarChar(80)
  kind       String  @db.VarChar(24) // SPORTS | ARTS
  parentId   String? @map("parent_id") @db.VarChar(64)
  selectable Boolean @default(true) @map("selectable")
  sortOrder  Int     @default(0) @map("sort_order")

  parent      RecreationalGroup?  @relation("RecTree", fields: [parentId], references: [id])
  children    RecreationalGroup[] @relation("RecTree")
  memberships RecreationalMembership[]

  @@index([parentId])
  @@index([kind])
  @@map("recreational_groups")
}

model RecreationalMembership {
  userId  String @map("user_id") @db.VarChar(64)
  groupId String @map("group_id") @db.VarChar(64)

  user  User               @relation(fields: [userId], references: [id])
  group RecreationalGroup  @relation(fields: [groupId], references: [id])

  @@id([userId, groupId])
  @@index([groupId])
  @@map("recreational_memberships")
}

model RecreationalSuggestion {
  id        String   @id @db.VarChar(64)
  userId    String   @map("user_id") @db.VarChar(64)
  name      String   @db.VarChar(80)
  kind      String   @db.VarChar(24)
  parentId  String?  @map("parent_id") @db.VarChar(64)
  status    String   @default("PENDING") @db.VarChar(16)
  groupId   String?  @map("group_id") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("recreational_suggestions")
}

model ProfileChurchDataRequest {
  id               String    @id @db.VarChar(64)
  userId           String    @map("user_id") @db.VarChar(64)
  changeName       Boolean   @default(false) @map("change_name")
  changeBipra      Boolean   @default(false) @map("change_bipra")
  changeKolom      Boolean   @default(false) @map("change_kolom")
  requestedName    String?   @map("requested_name") @db.VarChar(150)
  requestedBipra   String?   @map("requested_bipra") @db.VarChar(16)
  requestedKolomId String?   @map("requested_kolom_id") @db.VarChar(64)
  reason           String?   @db.Text
  status           String    @default("PENDING") @db.VarChar(16)
  adminNote        String?   @map("admin_note") @db.Text
  reviewedById     String?   @map("reviewed_by_id") @db.VarChar(64)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  reviewedAt       DateTime? @map("reviewed_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("profile_church_data_requests")
}

model User {
  id        String   @id @db.VarChar(64)
  email     String?  @unique @db.VarChar(190)
  name      String   @db.VarChar(150)
  avatar    String?  @db.Text
  phone     String?  @db.VarChar(40)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  // Profil lanjutan (join flow / waitlist promote)
  address       String? @db.Text
  origin        String? @map("origin") @db.VarChar(190)
  domicileKind   String? @map("domicile_kind") @db.VarChar(20)
  domicileDetail String? @map("domicile_detail") @db.VarChar(190)
  addressLine   String?  @map("address_line") @db.VarChar(255)
  village       String?  @map("village") @db.VarChar(120)
  district      String?  @map("district") @db.VarChar(120)
  city          String?  @map("city") @db.VarChar(120)
  province      String?  @map("province") @db.VarChar(80)
  postalCode    String?  @map("postal_code") @db.VarChar(12)
  lat           Float?
  lng           Float?
  placeId       String?  @map("place_id") @db.VarChar(255)
  addressNote   String?  @map("address_note") @db.VarChar(255)
  addressScope     String  @default("ID") @map("address_scope") @db.VarChar(8) // ID | INTL
  addressCountry   String  @default("ID") @map("address_country") @db.VarChar(2) // ISO 3166-1 alpha-2
  provinceCode     String? @map("province_code") @db.VarChar(8)
  cityCode         String? @map("city_code") @db.VarChar(12)
  districtCode     String? @map("district_code") @db.VarChar(16)
  villageCode      String? @map("village_code") @db.VarChar(20)

  lifeStatuses     Json?   @map("life_statuses")
  schoolLevel      String? @map("school_level") @db.VarChar(24)
  schoolName       String? @map("school_name") @db.VarChar(190)
  institutionId    String? @map("institution_id") @db.VarChar(64)
  major            String? @map("major") @db.VarChar(150)
  majorOther       String? @map("major_other") @db.VarChar(150)
  workplaceName    String? @map("workplace_name") @db.VarChar(190)
  workIndustry     String? @map("work_industry") @db.VarChar(80)
  workRole         String? @map("work_role") @db.VarChar(120)
  workplacePlaceId String? @map("workplace_place_id") @db.VarChar(255)

  giftsTop5     Json?   @map("gifts_top5")
  giftsScores   Json?   @map("gifts_scores")
  talents       Json?
  accountStatus String  @default("ACTIVE") @map("account_status") // ACTIVE | PENDING

  // Kategorial gereja (satu BIPRA) + program Pemuda
  onboardingStatus String  @default("ACTIVE") @map("onboarding_status") @db.VarChar(30) // WAITING_POOL | PENDING | ACTIVE
  isBeyonders      Boolean @default(false) @map("is_beyonders")
  bipra            Bipra   @default(PEMUDA)
  kolomId          String? @map("kolom_id") @db.VarChar(64)
  membershipKind   MembershipKind @default(JEMAAT) @map("membership_kind")

  // Taut akun Google (direktori dulu, bind belakangan)
  googleSub            String?   @unique @map("google_sub") @db.VarChar(64)
  linkStatus           String    @default("UNLINKED") @map("link_status") @db.VarChar(16) // UNLINKED | LINKED
  claimToken           String?   @unique @map("claim_token") @db.VarChar(64)
  claimTokenExpiresAt  DateTime? @map("claim_token_expires_at") @db.DateTime(3)

  // Gender & Emergency Contact
  gender                   String?   @map("gender") @db.VarChar(20) // LAKI-LAKI | PEREMPUAN
  birthDate                DateTime? @map("birth_date") @db.Date
  emergencyContactName     String?   @map("emergency_contact_name") @db.VarChar(150)
  emergencyContactRelation String?   @map("emergency_contact_relation") @db.VarChar(50) // ORANG_TUA | SAUDARA | TEMAN | LAINNYA
  emergencyContactPhone    String?   @map("emergency_contact_phone") @db.VarChar(40)
  emergencyContactAddress  String?   @map("emergency_contact_address") @db.Text
  lastProfileUpdate        DateTime? @map("last_profile_update") @db.DateTime(3)
  profileReminderDays      Int       @default(60) @map("profile_reminder_days")

  // Auth lokal (opsi selain Google SSO)
  passwordHash String? @map("password_hash") @db.Text
  authProvider String  @default("GOOGLE") @map("auth_provider") @db.VarChar(16)

  kolom                     Kolom?                     @relation(fields: [kolomId], references: [id])
  institution               Institution?               @relation(fields: [institutionId], references: [id])
  recreational              RecreationalMembership[]
  recreationalSuggestions   RecreationalSuggestion[]
  churchDataRequests        ProfileChurchDataRequest[]
  roles                     UserRole[]
  roleAssignments           RoleAssignment[]
  assignedBy                RoleAssignment[]   @relation("RoleAssignmentAssigner")
  waitingPool               WaitingPool?
  monitoring                MonitoringRecord[]
  groupMembers              GroupMember[]
  attendanceTaken           AttendanceRecord[] @relation("AttendanceRecorder")
  products                  Product[]
  orders                    Order[]
  serviceSchedules          ServiceSchedule[]
  mentorTransitionsOutgoing MentorTransition[] @relation("MentorTransitionOutgoing")
  mentorTransitionsIncoming MentorTransition[] @relation("MentorTransitionIncoming")
  mentorTransitionsCreated  MentorTransition[] @relation("MentorTransitionCreatedBy")
  orgAssignments            OrgAssignment[]
  orgAssignmentsGiven       OrgAssignment[] @relation("OrgAssignmentAssigner")

  @@index([kolomId])
  @@index([bipra])
  @@index([membershipKind])
  @@index([institutionId])
  @@index([addressScope])
  @@index([addressCountry])
  @@map("users")
}

/// Kampus / sekolah (katalog + bisa ditambah dari portal)
model Institution {
  id     String @id @db.VarChar(64)
  slug   String @unique @db.VarChar(80)
  name   String @db.VarChar(190)
  kind   String @db.VarChar(24) // UNIVERSITY | SCHOOL
  city   String? @db.VarChar(120)

  users User[]

  @@index([kind])
  @@map("institutions")
}

/// Kode undangan: link personal sekali-pakai atau link tim multi-use.
model InviteCode {
  code        String    @id @db.VarChar(16)
  type        String    @default("SINGLE") // SINGLE | TEAM
  defaultRole Role      @default(MENTEE)
  maxUses     Int       @default(1)
  uses        Int       @default(0)
  expiresAt   DateTime? @map("expires_at")
  createdBy   String?   @map("created_by") @db.VarChar(190)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  @@map("invite_codes")
}

/// Waitlist newcomer (cth. BAKU TAU) — dua tahap: daftar cepat → profil lengkap.
model WaitlistEntry {
  id              String   @id @db.VarChar(64)
  name            String   @db.VarChar(150)
  phone           String   @db.VarChar(40)
  email           String?  @db.VarChar(190)
  origin          String?  @map("origin") @db.VarChar(190)
  address         String?  @db.Text
  giftsTop5       Json?    @map("gifts_top5")
  giftsScores     Json?    @map("gifts_scores")
  talents         Json?
  notes           String?  @db.Text
  status          String   @default("WAITLISTED") // WAITLISTED | PROFILED | ASSIGNED
  sourceEventId   String?  @map("source_event_id") @db.VarChar(64)
  assignedGroupId String?  @map("assigned_group_id") @db.VarChar(64)
  promoteToken    String   @unique @map("promote_token") @db.VarChar(64)
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)

  // Gender & Emergency Contact (tahap B profil lengkap)
  gender                   String? @map("gender") @db.VarChar(20)
  emergencyContactName     String? @map("emergency_contact_name") @db.VarChar(150)
  emergencyContactRelation String? @map("emergency_contact_relation") @db.VarChar(50)
  emergencyContactPhone    String? @map("emergency_contact_phone") @db.VarChar(40)
  emergencyContactAddress  String? @map("emergency_contact_address") @db.Text

  @@index([status])
  @@map("waitlist_entries")
}

model UserRole {
  id           BigInt  @id @default(autoincrement())
  userId       String  @map("user_id") @db.VarChar(64)
  tenantId     String  @map("tenant_id") @db.VarChar(64)
  role         Role
  groupId      String? @map("group_id") @db.VarChar(64)
  assignmentId String? @map("assignment_id") @db.VarChar(64)

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  // Multi-role: satu orang boleh rangkap jabatan (mis. KOMISI + MENTOR).
  // "Effective role" ditentukan aplikasi via precedensi (src/lib/roles.ts).
  @@index([userId, tenantId])
  @@index([groupId])
  @@map("user_roles")
}

enum Role {
  SUPERADMIN
  BPMJ
  KOMISI
  COMMITTEE
  MENTOR
  CO_MENTOR
  MENTEE
  ALUMNI
}

model Group {
  id              String      @id @db.VarChar(64)
  tenantId        String      @map("tenant_id") @db.VarChar(64)
  name            String      @db.VarChar(100)
  meaning         String?     @db.VarChar(255)
  scripture       String?     @db.Text
  meetingSchedule String?     @map("meeting_schedule") @db.VarChar(150)
  meetingLocation String?     @map("meeting_location") @db.VarChar(255)
  color           String?     @db.VarChar(20)
  icon            String?     @db.VarChar(60)
  description     String?     @db.Text
  memberCount     Int         @default(0) @map("member_count")
  parentGroupId   String?     @map("parent_group_id") @db.VarChar(64)
  foundedPeriod   String?     @map("founded_period") @db.VarChar(10)
  status          GroupStatus @default(ACTIVE)

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  batches           GroupBatch[]
  members           GroupMember[]
  mentorTransitions MentorTransition[]
  parent            Group?             @relation("GroupLineage", fields: [parentGroupId], references: [id])
  children          Group[]            @relation("GroupLineage")
  attendance        AttendanceRecord[]
  roleAssignments   RoleAssignment[]

  @@index([tenantId])
  @@index([parentGroupId])
  @@map("groups")
}

enum GroupStatus {
  ACTIVE
  DORMANT
  MERGED
  ARCHIVED
}

/// Family tree per batch / regenerasi (sumber: Retreat Attendance GEHC YOUTH 2026.xlsx)
model GroupBatch {
  id           String   @id @db.VarChar(64)
  groupId      String   @map("group_id") @db.VarChar(64)
  period       String   @db.VarChar(10) // "2026-07" format YYYY-MM
  batchLabel   String?  @map("batch_label") @db.VarChar(190)
  mentorName   String   @map("mentor_name") @db.VarChar(150)
  comentorName String?  @map("comentor_name") @db.VarChar(150)
  theme        String?  @db.VarChar(255)
  isCurrent    Boolean  @default(false) @map("is_current")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)

  group Group @relation(fields: [groupId], references: [id])

  @@unique([groupId, period])
  @@index([groupId, period])
  @@map("group_batches")
}

/// Mentor/Comentor transition history (resign → mentee, batch change)
model MentorTransition {
  id             String      @id @db.VarChar(64)
  groupId        String      @map("group_id") @db.VarChar(64)
  outgoingUserId String      @map("outgoing_user_id") @db.VarChar(64)
  incomingUserId String?     @map("incoming_user_id") @db.VarChar(64)
  outgoingRole   FamilyRole  @map("outgoing_role")
  incomingRole   FamilyRole? @map("incoming_role")
  effectiveDate  DateTime    @map("effective_date") @db.Date
  reason         String?     @db.Text
  note           String?     @db.Text
  createdById    String      @map("created_by_id") @db.VarChar(64)
  createdAt      DateTime    @default(now()) @map("created_at") @db.DateTime(3)

  group        Group @relation(fields: [groupId], references: [id])
  outgoingUser User  @relation("MentorTransitionOutgoing", fields: [outgoingUserId], references: [id])
  incomingUser User? @relation("MentorTransitionIncoming", fields: [incomingUserId], references: [id])
  createdBy    User  @relation("MentorTransitionCreatedBy", fields: [createdById], references: [id])

  @@index([groupId, effectiveDate])
  @@map("mentor_transitions")
}

model GroupMember {
  id             String       @id @db.VarChar(64)
  groupId        String       @map("group_id") @db.VarChar(64)
  batchPeriod    String?      @map("batch_period") @db.VarChar(10)
  userId         String?      @map("user_id") @db.VarChar(64)
  name           String       @db.VarChar(150)
  email          String?      @db.VarChar(190)
  phone          String?      @db.VarChar(40)
  familyRole     FamilyRole   @default(MENTEE) @map("family_role")
  status         MemberStatus @default(ACTIVE)
  joinedDate     DateTime?    @map("joined_date") @db.Date
  alumniDate     DateTime?    @map("alumni_date") @db.Date
  alumniNote     String?      @map("alumni_note") @db.VarChar(255)
  attendanceRate Int          @default(0) @map("attendance_rate")
  notes          String?      @db.Text
  assignmentId   String?      @map("assignment_id") @db.VarChar(64)

  group      Group              @relation(fields: [groupId], references: [id])
  user       User?              @relation(fields: [userId], references: [id])
  attendance AttendanceRecord[]

  @@index([groupId])
  @@index([groupId, batchPeriod])
  @@index([userId])
  @@map("group_members")
}

enum FamilyRole {
  MENTOR
  COMENTOR
  MENTEE
}

enum MemberStatus {
  ACTIVE
  ALUMNI
}

model MonitoringRecord {
  id        String   @id @db.VarChar(64)
  groupId   String   @map("group_id") @db.VarChar(64)
  mentorId  String?  @map("mentor_id") @db.VarChar(64)
  date      DateTime @db.Date
  data      Json
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  mentor User? @relation(fields: [mentorId], references: [id])

  @@index([groupId, date])
  @@map("monitoring_records")
}

model ContentItem {
  id              String      @id @db.VarChar(64)
  tenantId        String      @map("tenant_id") @db.VarChar(64)
  type            ContentType
  title           String      @db.VarChar(255)
  subtitle        String?     @db.VarChar(255)
  body            String?     @db.MediumText
  category        String?     @db.VarChar(100)
  publishedAt     DateTime?   @map("published_at") @db.Date
  eventDate       DateTime?   @map("event_date") @db.Date
  locationDetail  String?     @map("location_detail") @db.VarChar(190)
  isFeaturedEvent Boolean     @default(false) @map("is_featured_event")
  isPublished     Boolean     @default(true) @map("is_published")
  author          String?     @db.VarChar(150)
  bannerUrl       String?     @map("banner_url") @db.Text
  pdfUrl          String?     @map("pdf_url") @db.Text
  tags            Json?
  driveFolderId   String?     @map("drive_folder_id") @db.VarChar(64)

  @@index([tenantId, type, publishedAt])
  @@map("content_items")
}

enum ContentType {
  WEEKLY_INFO
  ACTIVITY
}

model StrukturMember {
  id          String  @id @db.VarChar(64)
  name        String  @db.VarChar(150)
  position    String? @db.VarChar(190)
  division    String? @db.VarChar(150)
  subdivision String? @map("subdivision") @db.VarChar(100)
  period      String? @db.VarChar(60)
  photoUrl    String? @map("photo_url") @db.Text
  bio         String? @db.Text
  phone       String? @db.VarChar(40)
  email       String? @db.VarChar(190)
  sortOrder   Int     @default(0) @map("sort_order")
  isOpenRole  Boolean @default(false) @map("is_open_role")

  // Role hierarchy & multi-role support
  role         Role    @default(MENTEE) @map("role") // MENTOR | COMENTOR | MENTEE | KOMISI | COMMITTEE | BPMJ | SUPERADMIN | ALUMNI
  roleOrder    Int     @default(0) @map("role_order") // hierarchy within division
  isDoubleRole Boolean @default(false) @map("is_double_role") // rangkap jabatan
  subRoleId    String? @map("sub_role_id") @db.VarChar(64) // reference to another StrukturMember as sub-role
  groupId      String? @map("group_id") @db.VarChar(64) // mentoring group if applicable

  @@index([division])
  @@index([groupId])
  @@map("struktur_members")
}

/// Absensi per anggota per pertemuan — sumber aturan idle 4 minggu (Parameter 3)
model AttendanceRecord {
  id            String           @id @db.VarChar(64)
  groupId       String           @map("group_id") @db.VarChar(64)
  groupMemberId String           @map("group_member_id") @db.VarChar(64)
  date          DateTime         @db.Date
  status        AttendanceStatus @default(HADIR)
  note          String?          @db.VarChar(255)
  recordedById  String?          @map("recorded_by_id") @db.VarChar(64)
  createdAt     DateTime         @default(now()) @map("created_at") @db.DateTime(3)

  group    Group       @relation(fields: [groupId], references: [id])
  member   GroupMember @relation(fields: [groupMemberId], references: [id])
  recorder User?       @relation("AttendanceRecorder", fields: [recordedById], references: [id])

  @@unique([groupMemberId, date])
  @@index([groupId, date])
  @@map("attendance_records")
}

enum AttendanceStatus {
  HADIR
  IZIN
  SAKIT
  TANPA_KABAR
}

model EventProgram {
  id            String          @id @db.VarChar(64)
  tenantId      String          @map("tenant_id") @db.VarChar(16)
  slug          String          @unique @db.VarChar(60) // untuk tag Drive [EV:<slug>:<DIV>]
  name          String          @db.VarChar(160)
  description   String?         @db.Text
  status        String          @default("PLANNING") @db.VarChar(16) // PLANNING|ACTIVE|DONE|ARCHIVED
  startDate     DateTime?       @map("start_date")
  endDate       DateTime?       @map("end_date")
  driveFolderId String?         @map("drive_folder_id") @db.VarChar(128)
  gmeetLink         String?         @map("gmeet_link") @db.VarChar(512)
  whatsappGroupUrl  String?         @map("whatsapp_group_url") @db.VarChar(512)
  createdById       String          @map("created_by_id") @db.VarChar(64)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  divisions     EventDivision[]
  meetings      EventMeeting[]

  @@index([tenantId])
}

model EventDivision {
  id            String  @id @db.VarChar(64)
  eventId       String  @map("event_id") @db.VarChar(64)
  division      String  @db.VarChar(24) // LITURGIA…MARTURIA | BENZARPR | KOMISI | TIMKERJA
  driveFolderId String? @map("drive_folder_id") @db.VarChar(128)
  extraUserIds  Json?   @map("extra_user_ids") // [{userId}] manual

  // Approval workflow
  approvalStatus String    @default("DRAFT") @map("approval_status") @db.VarChar(16) // DRAFT|IN_REVIEW|APPROVED|REJECTED|PUBLISHED
  approvedById   String?   @map("approved_by_id") @db.VarChar(64)
  approvedAt     DateTime? @map("approved_at")
  rejectReason   String?   @map("reject_reason") @db.Text
  publishedAt    DateTime? @map("published_at")
  contentItemId  String?   @unique @map("content_item_id") @db.VarChar(64) // link to ContentItem when published

  createdAt DateTime @default(now()) @map("created_at")

  event        EventProgram          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  updates      EventUpdate[]
  members      EventDivisionMember[]
  approvalLogs EventApprovalLog[]

  @@unique([eventId, division])
  @@index([approvalStatus])
}

model EventMeeting {
  id          String   @id @db.VarChar(64)
  eventId     String   @map("event_id") @db.VarChar(64)
  division    String?  @db.VarChar(24) // null = rapat gabungan
  title       String   @db.VarChar(200)
  scheduledAt DateTime @map("scheduled_at")
  gmeetLink   String?  @map("gmeet_link") @db.VarChar(512)
  notes       String?  @db.Text
  createdById String   @map("created_by_id") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at")

  event EventProgram @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model EventUpdate {
  id              String   @id @db.VarChar(64)
  eventDivisionId String   @map("event_division_id") @db.VarChar(64)
  authorId        String   @map("author_id") @db.VarChar(64)
  body            String   @db.Text
  parentUpdateId  String?  @map("parent_update_id") @db.VarChar(64) // null = top-level, set = reply
  createdAt       DateTime @default(now()) @map("created_at")

  division EventDivision @relation(fields: [eventDivisionId], references: [id], onDelete: Cascade)

  @@index([eventDivisionId])
  @@index([parentUpdateId])
}

/// Role-based access per division member
model EventDivisionMember {
  id              String       @id @db.VarChar(64)
  eventDivisionId String       @map("event_division_id") @db.VarChar(64)
  userId          String       @map("user_id") @db.VarChar(64)
  role            DivisionRole @default(MEMBER)
  createdAt       DateTime     @default(now()) @map("created_at")

  division EventDivision @relation(fields: [eventDivisionId], references: [id], onDelete: Cascade)

  @@unique([eventDivisionId, userId])
  @@index([userId])
  @@map("event_division_members")
}

enum DivisionRole {
  LEAD
  CO_LEAD
  MEMBER
  VIEWER
}

/// Audit trail for approval actions
model EventApprovalLog {
  id              String   @id @db.VarChar(64)
  eventDivisionId String   @map("event_division_id") @db.VarChar(64)
  action          String   @db.VarChar(20) // SUBMIT|APPROVE|REJECT|PUBLISH|UNPUBLISH
  actorId         String   @map("actor_id") @db.VarChar(64)
  actorRole       String   @map("actor_role") @db.VarChar(30)
  comment         String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  division EventDivision @relation(fields: [eventDivisionId], references: [id], onDelete: Cascade)

  @@index([eventDivisionId])
  @@map("event_approval_logs")
}

/// Auto-flag idle, alert mitosis, saran merger — dasbor Komisi ("Jethro" engine)
model Notification {
  id         String             @id @db.VarChar(64)
  type       NotificationType
  groupId    String?            @map("group_id") @db.VarChar(64)
  memberId   String?            @map("member_id") @db.VarChar(64)
  title      String             @db.VarChar(190)
  message    String?            @db.Text
  payload    Json?
  status     NotificationStatus @default(OPEN)
  createdAt  DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  resolvedAt DateTime?          @map("resolved_at") @db.DateTime(3)

  @@index([type, status])
  @@index([groupId])
  @@map("notifications")
}

enum NotificationType {
  IDLE_FLAG
  MITOSIS_ALERT
  MERGER_SUGGESTION
  MENTION
}

enum NotificationStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

// ============================================
// Benzarpreneurship E-commerce
// ============================================

model Product {
  id          String   @id @db.VarChar(64)
  name        String   @db.VarChar(200)
  description String?  @db.Text
  price       Int // harga jual (rupiah)
  buyPrice    Int?     @map("buy_price") // harga beli/modal (rupiah), null untuk non-merchandise
  stock       Int      @default(0)
  images      Json     // [{driveFileId, url, caption}]
  category    String   @db.VarChar(20) // MERCHANDISE | FUNDRAISING | DONATION
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdById String   @map("created_by_id") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  createdBy  User        @relation(fields: [createdById], references: [id])
  orderItems OrderItem[]

  @@index([category, isActive])
  @@map("products")
}

enum ProductCategory {
  MERCHANDISE
  FUNDRAISING
  DONATION
}

model Order {
  id           String   @id @db.VarChar(64)
  orderCode    String   @unique @map("order_code") @db.VarChar(20) // BZP-20260827-001
  userId       String   @map("user_id") @db.VarChar(64)
  items        Json // [{productId, qty, price, nameSnapshot}]
  total        Int
  status       String   @default("PENDING") @db.VarChar(16) // PENDING|PAID|VERIFIED|PROCESSING|READY|COMPLETED|CANCELLED
  shipping     String   @default("PICKUP") @db.VarChar(16) // PICKUP | DELIVERY
  shippingAddr Json?    @map("shipping_addr") // {name, phone, address}
  notes        String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  user     User        @relation(fields: [userId], references: [id])
  itemsRel OrderItem[] @relation("OrderItems")

  @@index([userId, status])
  @@index([status])
  @@index([orderCode])
  @@map("orders")
}

model OrderItem {
  id        String @id @db.VarChar(64)
  orderId   String @map("order_id") @db.VarChar(64)
  productId String @map("product_id") @db.VarChar(64)
  qty       Int
  price     Int // harga saat beli (snapshot)
  name      String @db.VarChar(200) // nama produk saat beli (snapshot)

  order   Order   @relation("OrderItems", fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([orderId, productId])
  @@map("order_items")
}

enum OrderStatus {
  PENDING
  PAID
  VERIFIED
  PROCESSING
  READY
  COMPLETED
  CANCELLED
}

enum ShippingMethod {
  PICKUP
  DELIVERY
}

// ============================================================
// PENATALAYAN SCHEDULING
// ============================================================

model ServiceRole {
  id          String   @id @db.VarChar(64)
  name        String   @unique @db.VarChar(100)
  division    String   @db.VarChar(20) // LITURGIA | MARTURIA (mostly)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  schedules ServiceSchedule[]

  @@index([division, isActive])
  @@map("service_roles")
}

model ServiceSchedule {
  id            String   @id @db.VarChar(64)
  serviceRoleId String   @map("service_role_id") @db.VarChar(64)
  userId        String   @map("user_id") @db.VarChar(64)
  eventId       String?  @map("event_id") @db.VarChar(64) // null = ibadah mingguan
  date          DateTime @db.Date
  timeStart     String?  @map("time_start") @db.VarChar(10) // "13:00"
  timeEnd       String?  @map("time_end") @db.VarChar(10) // "15:00"
  status        String   @default("SCHEDULED") @db.VarChar(20) // SCHEDULED|CONFIRMED|DONE|CANCELLED
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  serviceRole ServiceRole @relation(fields: [serviceRoleId], references: [id])
  user        User        @relation(fields: [userId], references: [id])

  @@index([date, status])
  @@index([userId, date])
  @@index([serviceRoleId, date])
  @@map("service_schedules")
}

// ============================================================
// DIVISION MEETINGS & AGENDAS
// ============================================================

model DivisionMeeting {
  id          String   @id @db.VarChar(64)
  division    String   @db.VarChar(20) // LITURGIA | DIDASKALIA | etc
  meetingDate DateTime @map("meeting_date") @db.Date
  title       String?  @db.VarChar(200)
  agenda      Json     // [{topic, lead, output, deadline}]
  attendees   Json     // [{userId, role}]
  notes       String?  @db.Text
  status      String   @default("PLANNED") @db.VarChar(20) // PLANNED|IN_PROGRESS|DONE
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  agendaItems DivisionAgendaItem[]

  @@index([division, meetingDate])
  @@map("division_meetings")
}

model DivisionAgendaItem {
  id               String    @id @db.VarChar(64)
  meetingId        String    @map("meeting_id") @db.VarChar(64)
  title            String    @db.VarChar(200)
  description      String?   @db.Text
  division         String    @db.VarChar(20)
  component        String?   @db.VarChar(100) // "Rundown", "Slide", "Konsumsi", "PR Copy"
  personInChargeId String?   @map("person_in_charge_id") @db.VarChar(64)
  deadline         DateTime? @db.Date
  status           String    @default("TODO") @db.VarChar(20) // TODO|IN_PROGRESS|REVIEW|DONE
  driveFolderId    String?   @map("drive_folder_id") @db.VarChar(64) // link ke Drive
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  meeting DivisionMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, status])
  @@index([division, status])
  @@map("division_agenda_items")
}

// ============================================================
// WARTA PUBLIK (Weekly Bulletin Workflow)
// ============================================================

model WartaPublik {
  id            String    @id @db.VarChar(64)
  eventId       String?   @map("event_id") @db.VarChar(64)
  weekDate      DateTime  @map("week_date") @db.Date
  title         String    @db.VarChar(200)
  status        String    @default("DRAFT") @db.VarChar(20)
  contentJson   Json?     @map("content_json")
  pdfUrl        String?   @map("pdf_url") @db.VarChar(500)
  pngUrl        String?   @map("png_url") @db.VarChar(500)
  driveFolderId String?   @map("drive_folder_id") @db.VarChar(64)
  rejectReason  String?   @map("reject_reason") @db.Text
  createdById   String?   @map("created_by_id") @db.VarChar(64)
  reviewedById  String?   @map("reviewed_by_id") @db.VarChar(64)
  publishedAt   DateTime? @map("published_at") @db.DateTime(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([weekDate])
  @@index([status])
  @@map("warta_publik")
}

// ============================================================
// EVENT GALLERY (Photo/Video Upload with Approval)
// ============================================================

model EventGallery {
  id           String    @id @db.VarChar(64)
  eventId      String    @map("event_id") @db.VarChar(64)
  title        String    @db.VarChar(200)
  description  String?   @db.Text
  mediaUrl     String    @map("media_url") @db.VarChar(500)
  mediaType    String    @map("media_type") @db.VarChar(20)
  thumbUrl     String?   @map("thumb_url") @db.VarChar(500)
  uploadedById String    @map("uploaded_by_id") @db.VarChar(64)
  division     String?   @map("division") @db.VarChar(20)
  status       String    @default("PENDING") @db.VarChar(20)
  approvedById String?   @map("approved_by_id") @db.VarChar(64)
  approvedAt   DateTime? @map("approved_at") @db.DateTime(3)
  rejectReason String?   @map("reject_reason") @db.Text
  driveFileId  String?   @map("drive_file_id") @db.VarChar(64)
  sortOrder    Int       @default(0) @map("sort_order")
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([eventId, status])
  @@index([division, status])
  @@map("event_gallery")
}

// ============================================================
// ROLE ASSIGNMENT (Hierarchical role tracking)
// Source of truth for admin role assignments with sub-role context.
// Dual-written to UserRole for backward compatibility.
// ============================================================

model RoleAssignment {
  id     String @id @db.VarChar(64)
  userId String @map("user_id") @db.VarChar(64)
  role   Role // SUPERADMIN | BPMJ | KOMISI | COMMITTEE | MENTEE

  // === Context: BPMJ / KOMISI ===
  position String? @db.VarChar(100) // "Ketua BPMJ", "Wakil Ketua Komisi", etc.

  // === Context: COMMITTEE ===
  division    String? @db.VarChar(150) // "LITURGIA", "DIDASKALIA", etc.
  subdivision String? @db.VarChar(100) // "Pendoa", "Konsumsi", etc.

  // === Context: BEYONDERS (MENTEE with group) ===
  groupId    String? @map("group_id") @db.VarChar(64)
  familyRole String? @db.VarChar(20) // "MENTOR" | "CO_MENTOR" | "MENTEE"

  // === Metadata ===
  assignedBy String    @map("assigned_by") @db.VarChar(64)
  assignedAt DateTime  @default(now()) @map("assigned_at")
  expiresAt  DateTime? @map("expires_at")
  isActive   Boolean   @default(true) @map("is_active")
  note       String?   @db.Text

  user     User   @relation(fields: [userId], references: [id])
  assigner User   @relation("RoleAssignmentAssigner", fields: [assignedBy], references: [id])
  group    Group? @relation(fields: [groupId], references: [id])

  @@index([userId])
  @@index([role])
  @@index([groupId])
  @@index([assignedBy])
  @@unique([userId, role, groupId], map: "unique_user_role_group")
  @@map("role_assignments")
}

// ============================================================
// ORG HIERARCHY — configurable church structure (YOUTH / KOLOM / CHURCH)
// ============================================================

model OrgNode {
  id       String  @id @db.VarChar(64)
  domain   String  @db.VarChar(24) // YOUTH | KOLOM | CHURCH
  parentId String? @map("parent_id") @db.VarChar(64)
  slug     String  @db.VarChar(80)
  label    String  @db.VarChar(150)
  nodeKind String  @map("node_kind") @db.VarChar(24) // BRANCH | POSITION_SLOT | GROUP_REF
  metadata Json?
  sortOrder Int    @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  parent      OrgNode?        @relation("OrgTree", fields: [parentId], references: [id])
  children    OrgNode[]       @relation("OrgTree")
  assignments OrgAssignment[]

  @@unique([domain, slug])
  @@index([domain])
  @@index([parentId])
  @@map("org_nodes")
}

model OrgAssignment {
  id               String   @id @db.VarChar(64)
  userId           String   @map("user_id") @db.VarChar(64)
  orgNodeId        String   @map("org_node_id") @db.VarChar(64)
  position         String?  @db.VarChar(150)
  roleAssignmentId String?  @map("role_assignment_id") @db.VarChar(64)
  assignedBy       String   @map("assigned_by") @db.VarChar(64)
  assignedAt       DateTime @default(now()) @map("assigned_at") @db.DateTime(3)
  isActive         Boolean  @default(true) @map("is_active")

  user     User    @relation(fields: [userId], references: [id])
  orgNode  OrgNode @relation(fields: [orgNodeId], references: [id])
  assigner User    @relation("OrgAssignmentAssigner", fields: [assignedBy], references: [id])

  @@index([userId])
  @@index([orgNodeId])
  @@index([assignedBy])
  @@map("org_assignments")
}

// ============================================================
// WAITING POOL (Onboarding pipeline)
// Tracks newcomers from registration through profile completion
// to role assignment. Replaces WaitlistEntry for active pipeline.
// ============================================================

model WaitingPool {
  id     String  @id @db.VarChar(64)
  userId String? @map("user_id") @db.VarChar(64)
  name   String  @db.VarChar(150)
  email  String? @db.VarChar(190)
  phone  String? @db.VarChar(40)
  gender String? @db.VarChar(20)
  origin         String? @db.VarChar(190)
  domicileKind   String? @map("domicile_kind") @db.VarChar(20)
  domicileDetail String? @map("domicile_detail") @db.VarChar(190)
  claimToken     String? @unique @map("claim_token") @db.VarChar(64)

  // Onboarding status
  status String @default("WAITING_POOL") @db.VarChar(30)
  // REGISTERED | WAITING_POOL | PROFILE_COMPLETED | ROLE_ASSIGNED

  // Gift test tracking
  giftTestDone Boolean @default(false) @map("gift_test_done")
  giftsTop5    Json?   @map("gifts_top5")
  giftsScores  Json?   @map("gifts_scores")
  talents      Json?

  // Profile completion
  profileCompleted   Boolean   @default(false) @map("profile_completed")
  profileCompletedAt DateTime? @map("profile_completed_at")

  // Metadata
  sourceEvent   String?   @db.VarChar(100) // "BAKUTAU 4.0"
  registeredAt  DateTime  @default(now()) @map("registered_at")
  lastReminder  DateTime? @map("last_reminder")
  reminderCount Int       @default(0) @map("reminder_count")

  user User? @relation(fields: [userId], references: [id])

  @@unique([userId])
  @@index([status])
  @@map("waiting_pool")
}

// ============================================================
// JETHRO PLACEMENT REVIEW
// Tracks auto-assignment recommendations from Jethro Engine
// through admin review to final commit.
// ============================================================

model PlacementBatch {
  id          String   @id @default(cuid())
  status      String   @default("DRAFT") @db.VarChar(30)
  // DRAFT | GENERATED | REVIEWING | APPROVED | COMMITTED | REJECTED
  createdBy   String   @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at")
  generatedAt DateTime? @map("generated_at")
  reviewedAt  DateTime? @map("reviewed_at")
  reviewedBy  String?   @db.VarChar(64)
  committedAt DateTime? @map("committed_at")
  committedBy String?   @db.VarChar(64)
  items       PlacementItem[]

  @@index([status])
  @@index([createdBy])
  @@map("placement_batches")
}

model PlacementItem {
  id                    String   @id @default(cuid())
  batchId               String   @map("batch_id")
  newcomerId            String   @map("newcomer_id") @db.VarChar(64)
  newcomerName          String   @map("newcomer_name") @db.VarChar(150)
  newcomerGender        String   @map("newcomer_gender") @db.VarChar(20)
  newcomerGiftsTop5     Json     @map("newcomer_gifts_top5")
  newcomerMaturityScore Float?   @map("newcomer_maturity_score")

  recommendedGroupId    String?  @map("recommended_group_id") @db.VarChar(64)
  recommendedGroupName  String?  @map("recommended_group_name") @db.VarChar(150)
  recommendedRole       String?  @map("recommended_role") @db.VarChar(30)
  confidence            Float
  reasons               Json
  scoreBreakdown        Json?    @map("score_breakdown")

  status                String   @default("PENDING") @db.VarChar(30)
  // PENDING | APPROVED | REVISED | REJECTED | INDIVIDU
  finalGroupId          String?  @map("final_group_id") @db.VarChar(64)
  finalRole             String?  @map("final_role") @db.VarChar(30)
  finalIsIndividu       Boolean  @default(false) @map("final_is_individu")

  reviewedBy            String?  @map("reviewed_by") @db.VarChar(64)
  reviewedAt            DateTime? @map("reviewed_at")

  batch                 PlacementBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([newcomerId])
  @@index([status])
  @@map("placement_items")
}
